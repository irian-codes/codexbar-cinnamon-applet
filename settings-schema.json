{
    "layout": {
        "type": "layout",
        "pages": [
            "general"
        ],
        "general": {
            "type": "page",
            "title": "General",
            "sections": [
                "command",
                "display"
            ]
        },
        "command": {
            "type": "section",
            "title": "CodexBar",
            "keys": [
                "command-path",
                "provider",
                "source",
                "refresh-interval"
            ]
        },
        "display": {
            "type": "section",
            "title": "Display",
            "keys": [
                "providers",
                "gauge-provider",
                "time-format"
            ]
        }
    },
    "command-path": {
        "type": "entry",
        "default": "/opt/apps/codexbar/codexbar",
        "description": "CodexBar command path"
    },
    "provider": {
        "type": "combobox",
        "default": "codex",
        "description": "Provider",
        "options": {
            "Enabled providers": "enabled",
            "Codex": "codex",
            "OpenAI": "openai",
            "Claude": "claude",
            "Gemini": "gemini"
        }
    },
    "source": {
        "type": "combobox",
        "default": "auto",
        "description": "Data source",
        "tooltip": "Auto follows CodexBar's own fallback order. OAuth is much faster for Claude but is not offered by every provider.",
        "options": {
            "Auto": "auto",
            "OAuth": "oauth",
            "Web": "web",
            "CLI": "cli"
        }
    },
    "refresh-interval": {
        "type": "spinbutton",
        "default": 60,
        "min": 15,
        "max": 3600,
        "step": 15,
        "units": "seconds",
        "description": "Refresh interval"
    },
    "providers": {
        "type": "list",
        "description": "Providers to show",
        "tooltip": "Filled in automatically from the providers enabled in CodexBar. Untick to hide a provider's tab.",
        "columns": [
            {
                "id": "provider",
                "title": "Provider",
                "type": "string"
            },
            {
                "id": "show",
                "title": "Show",
                "type": "boolean"
            }
        ],
        "default": []
    },
    "gauge-provider": {
        "type": "combobox",
        "default": "codex",
        "description": "Provider for the gauge when minimized",
        "tooltip": "Which provider the panel gauge tracks. The list narrows to the providers CodexBar actually returned once usage has been fetched.",
        "options": {
            "Codex": "codex",
            "OpenAI": "openai",
            "Claude": "claude",
            "Gemini": "gemini"
        }
    },
    "time-format": {
        "type": "combobox",
        "default": "system",
        "description": "Time format",
        "tooltip": "Follow system uses the clock format from Date & Time settings.",
        "options": {
            "Follow system": "system",
            "24-hour": "24h",
            "12-hour": "12h"
        }
    }
}
